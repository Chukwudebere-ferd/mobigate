{
  "name": "mgm-portal",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:auth": "pnpm --filter @mgm/auth dev",
    "dev:api": "cd backend && go run ./cmd/mgm-api",
    "seed:dev": "pnpm --filter @mgm/auth seed:dev",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "typecheck": "pnpm --filter frontend exec tsc -b --noEmit"
  }
}
