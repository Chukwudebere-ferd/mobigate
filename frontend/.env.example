# Copy to .env and adjust.
#
# Base URLs. Leave empty to use the Vite dev proxy (same origin), which
# forwards /api/auth to Better Auth (:3000) and /api to the Go API (:8080).
# Set these only when hosting the API on another origin, e.g.
# VITE_API_URL=https://api.example.com/api
# VITE_AUTH_URL=https://api.example.com
# VITE_API_URL=
# VITE_AUTH_URL=
