# Copy to .env and adjust.
#
# VITE_AUTH_MODE: 'mock' (default) or 'live' for Better Auth sessions.
# VITE_API_MODE:  'mock' (default) or 'live' for the Go API.
VITE_AUTH_MODE=mock
VITE_API_MODE=mock
# Optional domain switches. Each defaults to VITE_API_MODE, so the admin panel
# can be live while public/applicant pages stay on mocks.
# VITE_DASHBOARD_MODE=live
# VITE_RECRUITMENT_MODE=live
# VITE_ADMIN_MODE=live

# Base URLs. Leave empty to use the Vite dev proxy (same origin).
# VITE_API_URL=
# VITE_AUTH_URL=
