# Copy to .env and adjust.
#
# VITE_AUTH_MODE: 'mock' (default) or 'live' for Better Auth sessions.
# VITE_API_MODE:  'mock' (default) or 'live' for the Go API.
VITE_AUTH_MODE=mock
VITE_API_MODE=mock
# Optional: serve dashboard data live while the rest of the admin panel stays
# on mocks. Defaults to VITE_API_MODE.
# VITE_DASHBOARD_MODE=live

# Base URLs. Leave empty to use the Vite dev proxy (same origin).
# VITE_API_URL=
# VITE_AUTH_URL=
