# --- Frontend -----------------------------------------------------------
# 'mock' runs the UI against in-memory seed data (default).
# 'live' points the API client at the Go server.
VITE_API_MODE=mock

# Base URL for the Go API. Empty means same-origin, which is what the Vite
# dev proxy expects.
VITE_API_URL=

# --- Go API -------------------------------------------------------------
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mgm?sslmode=disable

# --- Better Auth --------------------------------------------------------
AUTH_BASE_URL=http://localhost:3000
AUTH_SECRET=change-me-in-production
ALLOWED_HOSTS=*

# --- Notification providers --------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
