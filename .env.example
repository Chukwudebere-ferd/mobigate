# --- Frontend -----------------------------------------------------------
# 'mock' runs the UI against in-memory seed data (default).
# 'live' points the API client at the Go server.
VITE_API_MODE=mock

# Base URL for the Go API. Empty means same-origin, which is what the Vite
# dev proxy expects.
VITE_API_URL=

# --- Go API -------------------------------------------------------------
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mgm?sslmode=disable

# --- Better Auth --------------------------------------------------------
AUTH_BASE_URL=http://localhost:3000
AUTH_SECRET=change-me-in-production
ALLOWED_HOSTS=*
# Browser origins allowed to call Better Auth through the proxy.
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Go API origin check for state-changing requests. Same-origin requests are
# always allowed; list additional trusted browser origins here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- First Super Admin (run once) --------------------------------------
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FIRST_NAME=
# BOOTSTRAP_ADMIN_LAST_NAME=
# BOOTSTRAP_TENANT_ID=20000000-0000-0000-0000-000000000001

# --- Notification providers --------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
